{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.ts": { "includeFiles": "public/{404,rail}.html" }
  },
  "rewrites": [
    { "source": "/grove/:path(.*)", "destination": "/api/proxy?project=grove&path=:path" },
    { "source": "/hotswap/:path(.*)", "destination": "/api/proxy?project=hotswap&path=:path" },
    { "source": "/pty/:path(.*)", "destination": "/api/proxy?project=pty&path=:path" },
    { "source": "/routines/:path(.*)", "destination": "/api/proxy?project=routines&path=:path" },
    { "source": "/sandman/:path(.*)", "destination": "/api/proxy?project=sandman&path=:path" },
    { "source": "/stele/:path(.*)", "destination": "/api/proxy?project=stele&path=:path" },
    { "source": "/ui/:path(.*)", "destination": "/api/proxy?project=ui&path=:path" }
  ],
  "trailingSlash": true
}
